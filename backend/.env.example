# Copy to `.env` for local development. Never commit the real file.

# --- Database (Aiven MySQL) ---
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TEAM_JWT_SECRET=
TEAM_JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated browser origins allowed to call this API.
# Requests with no Origin header (the native app) are always allowed.
# Add your Vercel URL here, e.g. https://episilion-admins.vercel.app
CORS_ORIGINS=http://localhost:8081,http://localhost:8099

# --- Session cookie ---
# The web app and this API are on different sites, so the cookie must be
# SameSite=None, which browsers only accept together with Secure (HTTPS).
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
