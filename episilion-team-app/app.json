{
  "expo": {
    "name": "Episilion Admins",
    "slug": "episilion-team-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/episilion_logo.png",
    "userInterfaceStyle": "automatic",
    "scheme": "episilion-team-app",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.astrosteck.episilionteamapp"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/episilion_logo.png",
      "name": "Episilion Admins",
      "shortName": "Episilion",
      "themeColor": "#007AFF",
      "backgroundColor": "#FFFFFF",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61633858-ffaf-46fd-b208-e6d11f5d5899"
      }
    }
  }
}
